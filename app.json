{
  "expo": {
    "name": "boogie",
    "slug": "boogie",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.boogie.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to show nearby content."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.boogie.app"
    },
    "plugins": [
      "expo-font",
      "expo-asset"
    ]
  }
}
